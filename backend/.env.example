APP_NAME=RapidSale
APP_ENV=development            # production enables strict secret checks
PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rapidsale
DB_PASSWORD=rapidsale
DB_NAME=rapidsale
AUTO_MIGRATE=true

# Generate with: openssl rand -hex 32
JWT_SECRET=
OTP_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
OTP_TTL=5m
OTP_DEBUG=true                 # returns OTP codes in API responses; MUST be false in production

# OTP delivery: console (logs codes) | twilio ; console | smtp
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8080

# Image storage: local (served from /uploads) | s3
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_PUBLIC_URL=

AUTO_APPROVE_LISTINGS=true     # false = new/edited ads wait for moderation
LISTING_TTL_DAYS=30

SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@rapidsale.local
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=ChangeMe123!
