# ---- Copy to .env on the EC2 host and fill in. Never commit .env. ----
DOMAIN=example.com
LETSENCRYPT_EMAIL=ops@example.com
APP_NAME=RapidSale

DB_NAME=rapidsale
DB_USER=rapidsale
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-another-strong-password

# openssl rand -hex 32
JWT_SECRET=
OTP_SECRET=
OTP_DEBUG=false

# OTP delivery (production): twilio for SMS, smtp for email (e.g. Amazon SES SMTP)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_PROVIDER=smtp
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# local = docker volume; s3 = bucket (attach an IAM role with s3:PutObject to the EC2 instance)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_PUBLIC_URL=

AUTO_APPROVE_LISTINGS=false
LISTING_TTL_DAYS=30

SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PHONE=
SUPERADMIN_PASSWORD=change-me-on-first-login
