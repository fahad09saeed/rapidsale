# Rendered by the nginx image (envsubst) into /etc/nginx/conf.d/default.conf. ${DOMAIN} comes from .env.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    # deploy/ec2-setup.sh switches this to a redirect after issuing a certificate.
    include /etc/nginx/conf.d/app.locations;
}
